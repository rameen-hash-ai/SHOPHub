<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brand | Product Detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header class="top-bar">
        <div class="top-bar-left">
            <span>🌐 English, USD</span>
            <span>Ship to 🇩🇪</span>
        </div>
    </header>

    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">🅱 Brand</a>
            <div class="search-box">
                <input type="text" placeholder="Search...">
                <select><option>All category</option></select>
                <button class="btn-search">Search</button>
            </div>
            <div class="nav-icons">
                <a href="#">👤<span>Profile</span></a>
                <a href="#">🛒<span>My cart</span></a>
            </div>
        </div>
        <div class="secondary-nav">
            <a href="#">☰ All category</a>
            <a href="#">Hot offers</a>
            <a href="#">Gift boxes</a>
        </div>
    </nav>

    <div class="breadcrumb">
        <a href="/">Home</a> › <a href="#">Clothings</a> › <a href="#">Mens wear</a> › <span>Summer clothing</span>
    </div>

    <div class="detail-layout">

        <!-- LEFT: Images -->
        <div class="detail-images">
            <img src="https://via.placeholder.com/400x350/eeeeee/333333?text=Product" alt="Product" class="main-img">
            <div class="thumbnail-row">
                <img src="https://via.placeholder.com/70x60" alt="">
                <img src="https://via.placeholder.com/70x60" alt="">
                <img src="https://via.placeholder.com/70x60" alt="">
                <img src="https://via.placeholder.com/70x60" alt="">
            </div>
        </div>

        <!-- RIGHT: Info -->
        <!-- Replace the detail-info section -->
        <div class="detail-info">
            <p class="in-stock"><% if(product.stock > 0) { %>✔ In stock (<%= product.stock %> units)<% } else { %>❌ Out of stock<% } %></p>
            <h1><%= product.name %></h1>

            <div class="rating-row">
                <span class="stars">
                    <% for(let i = 1; i <= 5; i++) { %>
                        <%= i <= Math.round(product.rating/2) ? '★' : '☆' %>
                    <% } %>
                </span>
                <span><%= product.rating %></span>
                <span class="sep">|</span>
                <span><%= product.reviews %> reviews</span>
                <span class="sep">|</span>
                <span><%= product.sold %> sold</span>
            </div>

            <!-- PRICING TIERS (as in Figma) -->
            <div class="price-tiers">
                <div class="tier active-tier">
                    <span class="tier-price">$<%= product.price.toFixed(2) %></span>
                    <span class="tier-qty">50-100 pcs</span>
                </div>
                <div class="tier">
                    <span class="tier-price">$<%= (product.price * 0.91).toFixed(2) %></span>
                    <span class="tier-qty">100-700 pcs</span>
                </div>
                <div class="tier">
                    <span class="tier-price">$<%= (product.price * 0.79).toFixed(2) %></span>
                    <span class="tier-qty">700+ pcs</span>
                </div>
            </div>
            
            
            <!-- SPECS TABLE -->
            <table class="specs-table">
                <tr><td>Price</td><td>$<%= product.price.toFixed(2) %></td></tr>
                <tr><td>Brand</td><td><%= product.brand %></td></tr>
                <tr><td>Category</td><td><%= product.category %></td></tr>
                <tr><td>Stock</td><td><%= product.stock %> units</td></tr>
                <tr><td>Sold</td><td><%= product.sold %> units</td></tr>
                <tr><td>Rating</td><td><%= product.rating %>/10</td></tr>
            </table>
            

            <div class="detail-actions">
                <button class="btn-primary">Send inquiry</button>
                <button class="btn-secondary">Save for later</button>
            </div>
        </div>
    </div>

    <!-- TABS: Description / Reviews / Shipping -->
    <div class="tabs-section">
        <div class="tabs">
            <button class="tab active" onclick="switchTab(this, 'description')">Description</button>
            <button class="tab" onclick="switchTab(this, 'reviews')">Reviews</button>
            <button class="tab" onclick="switchTab(this, 'shipping')">Shipping</button>
            <button class="tab" onclick="switchTab(this, 'seller')">About seller</button>
        </div>
        <!-- Description tab content -->
        <div id="description" class="tab-content active">
            <p><%= product.description %></p>
        </div>
        
        

    <!-- RELATED PRODUCTS -->
    <section class="related-section">
        <h3>Related products</h3>
        <div class="product-grid">
            <% relatedProducts.forEach(p => { %>
            <div class="product-card" onclick="window.location='/products/<%= p._id %>'">
                <div class="card-top">
                    <img src="<%= p.image %>" alt="<%= p.name %>">
                </div>
                <div class="card-body">
                    <p class="product-name"><%= p.name %></p>
                    <div class="price-row">
                        <span class="price">$<%= p.price.toFixed(2) %></span>
                        <span class="old-price">$<%= p.originalPrice.toFixed(2) %></span>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
        
        
        
         
    </section>

    <footer class="footer">
        <div class="footer-bottom"><p>© 2026 Brand. All rights reserved.</p></div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>