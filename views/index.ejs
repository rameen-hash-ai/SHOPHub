<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brand | Home</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- TOP NAV -->
    <header class="top-bar">
        <div class="top-bar-left">
            <span>🌐 English, USD</span>
            <span>Ship to 🇩🇪</span>
        </div>
    </header>

    <!-- MAIN NAVBAR -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">🅱 Brand</a>

            <div class="search-box">
                <input type="text" placeholder="Search...">
                <select>
                    <option>All category</option>
                    <option>Electronics</option>
                    <option>Clothing</option>
                    <option>Accessories</option>
                </select>
                <button class="btn-search">Search</button>
            </div>

            <div class="nav-icons">
                 <% if (user) { %>
                    <a href="/add-product">➕<span>Add</span></a>
                    <a href="/logout">🚪<span>Logout</span></a>
                <% } else { %>
                    <a href="/login">👤<span>Login</span></a>
                <% } %>
                <a href="#">🛒<span>My cart</span></a>
            </div>
        </div>

        <!-- SECONDARY NAV -->
        <div class="secondary-nav">
            <a href="#">☰ All category</a>
            <a href="#">Hot offers</a>
            <a href="#">Gift boxes</a>
            <a href="#">Projects</a>
            <a href="#">Menu item</a>
            <div class="dropdown"><a href="#">Help ▾</a></div>
        </div>
    </nav>

    <!-- HERO BANNER -->
    <section class="hero">
        <div class="hero-content">
            <p>Latest trending</p>
            <h1>Electronic Items</h1>
            <a href="/products" class="btn-primary">Learn more</a>
        </div>
        <div class="hero-image">
            <img src="https://via.placeholder.com/400x300/1a1a2e/ffffff?text=Electronics" alt="Hero">
        </div>
    </section>

    <!-- DEALS & OFFERS -->
    <section class="info-cards">
        <div class="info-card">
            <span>🚚</span>
            <div>
                <strong>Free Shipping</strong>
                <p>Order over $100</p>
            </div>
        </div>
        <div class="info-card">
            <span>💰</span>
            <div>
                <strong>Money Guarantee</strong>
                <p>Within 30 days</p>
            </div>
        </div>
        <div class="info-card">
            <span>🎧</span>
            <div>
                <strong>Online Support</strong>
                <p>24 hours a day</p>
            </div>
        </div>
        <div class="info-card">
            <span>💳</span>
            <div>
                <strong>Flexible Payment</strong>
                <p>Pay with multiple cards</p>
            </div>
        </div>
    </section>

    <!-- FEATURED PRODUCTS -->
    <section class="featured-section">
        <div class="section-header">
            <h2>Featured Products</h2>
            <a href="/products" class="view-all">View all →</a>
        </div>
        <div class="product-grid">
            <% products.forEach(product => { %>
            <div class="product-card" onclick="window.location='/products/<%= product._id %>'">
                <div class="card-top">
                    <img src="<%= product.image %>" alt="<%= product.name %>">
                    <button class="wishlist">♡</button>
                </div>
                <div class="card-body">
                    <p class="product-name"><%= product.name %></p>
                    <div class="stars">
                        <% for(let i = 1; i <= 5; i++) { %>
                            <%= i <= Math.round(product.rating/2) ? '★' : '☆' %>
                        <% } %>
                        <span><%= product.rating %></span>
                    </div>
                    <div class="price-row">
                        <span class="price">$<%= product.price.toFixed(2) %></span>
                        <span class="old-price">$<%= product.originalPrice.toFixed(2) %></span>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer-grid">
            <div>
                <h4>🅱 Brand</h4>
                <p>Best information about the company goes here.</p>
            </div>
            <div>
                <h4>About</h4>
                <a href="#">About Us</a>
                <a href="#">Find store</a>
                <a href="#">Categories</a>
            </div>
            <div>
                <h4>Partnership</h4>
                <a href="#">About Us</a>
                <a href="#">Find store</a>
            </div>
            <div>
                <h4>Information</h4>
                <a href="#">Help Center</a>
                <a href="#">Money Refund</a>
                <a href="#">Shipping Info</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 Brand. All rights reserved.</p>
            <div class="payment-icons">💳 Visa · Mastercard · PayPal</div>
        </div>
    </footer>

</body>
</html>