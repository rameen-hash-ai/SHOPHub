<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brand | Products</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <header class="top-bar">
        <div class="top-bar-left">
            <span>🌐 English, USD</span>
            <span>Ship to 🇩🇪</span>
        </div>
    </header>

    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">🅱 Brand</a>
            <div class="search-box">
                <input type="text" placeholder="Search..." id="searchInput">
                <select>
                    <option>All category</option>
                    <option>Electronics</option>
                    <option>Clothing</option>
                </select>
                <button class="btn-search" onclick="handleSearch()">Search</button>
            </div>
            <div class="nav-icons">
                <div class="nav-icons">
                    <% if (user) { %>
                        <a href="/add-product">➕<span>Add</span></a>
                        <a href="/logout">🚪<span>Logout</span></a>
                    <% } else { %>
                        <a href="/login">👤<span>Login</span></a>
                    <% } %>
                    <a href="#">🛒<span>My cart</span></a>
                </div>
            </div>
        </div>
        <div class="secondary-nav">
            <a href="#">☰ All category</a>
            <a href="#">Hot offers</a>
            <a href="#">Gift boxes</a>
            <a href="#">Projects</a>
        </div>
    </nav>

    <!-- BREADCRUMB -->
    <div class="breadcrumb">
        <a href="/">Home</a> › <a href="/products">Products</a> › <span>Mobile accessory</span>
    </div>

    <div class="products-layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="filter-group">
                <h4>Category <span>∧</span></h4>
                <ul>
                    <li><a href="#">Mobile accessory</a></li>
                    <li><a href="#">Electronics</a></li>
                    <li><a href="#">Smartphones</a></li>
                    <li><a href="#">Modern tech</a></li>
                    <li><a href="#" class="see-all">See all</a></li>
                </ul>
            </div>

            <div class="filter-group">
                <h4>Brands <span>∧</span></h4>
                <label><input type="checkbox" checked> Samsung</label>
                <label><input type="checkbox" checked> Apple</label>
                <label><input type="checkbox"> Huawei</label>
                <label><input type="checkbox" checked> Pocco</label>
                <label><input type="checkbox"> Lenovo</label>
                <a href="#" class="see-all">See all</a>
            </div>

            <div class="filter-group">
                <h4>Features <span>∧</span></h4>
                <label><input type="checkbox" checked> Metallic</label>
                <label><input type="checkbox"> Plastic cover</label>
                <label><input type="checkbox"> 8GB Ram</label>
                <label><input type="checkbox"> Super power</label>
                <label><input type="checkbox"> Large Memory</label>
            </div>

            <div class="filter-group">
                <h4>Price range</h4>
                <input type="range" min="0" max="500" value="250" class="price-range">
                <div class="price-labels"><span>$0</span><span>$500</span></div>
            </div>

            <div class="filter-group">
                <h4>Condition</h4>
                <label><input type="radio" name="condition"> Any</label>
                <label><input type="radio" name="condition"> Refurbished</label>
                <label><input type="radio" name="condition"> Brand New</label>
            </div>

            <div class="filter-group">
                <h4>Ratings</h4>
                <label><input type="radio" name="rating"> ★★★★★</label>
                <label><input type="radio" name="rating"> ★★★★☆</label>
                <label><input type="radio" name="rating"> ★★★☆☆</label>
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <main class="products-main">

            <div class="products-header">
                <p><%= totalCount %> items found
                   <% if (searchQuery) { %> for "<strong><%= searchQuery %></strong>"<% } %>
                </p>
                <div class="products-controls">
                    <label><input type="checkbox"> Verified only</label>
                    <select>
                        <option>Featured</option>
                        <option>Price: Low to High</option>
                        <option>Price: High to Low</option>
                    </select>
                </div>
            </div>

            <!-- ACTIVE FILTERS -->
            <div class="active-filters">
                <span class="filter-tag">Samsung ✕</span>
                <span class="filter-tag">Apple ✕</span>
                <span class="filter-tag">Poco ✕</span>
                <span class="filter-tag">Metallic ✕</span>
                <span class="filter-tag">4 star ✕</span>
                <a href="#" class="clear-filters">Clear all filter</a>
            </div>

            <!-- PRODUCT GRID -->
          

            <!-- Replace the hardcoded product grid -->
            <div class="product-grid">
                <% if (products.length === 0) { %>
                    <div style="grid-column: 1/-1; text-align:center; padding: 3rem; color: #888;">
                        <p>No products found. Try a different search.</p>
                    </div>
                <% } else { %>
                    <% products.forEach(product => { %>
                    <div class="product-card" onclick="window.location='/products/<%= product._id %>'">
                        <div class="card-top">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <button class="wishlist">♡</button>
                        </div>
                        <div class="card-body">
                            <p class="product-name"><%= product.name %></p>
                            <p class="category"><%= product.category %></p>
                            <div class="stars">
                                <% for(let i = 1; i <= 5; i++) { %>
                                    <%= i <= Math.round(product.rating/2) ? '★' : '☆' %>
                                <% } %>
                                <span><%= product.rating %></span>
                            </div>
                            <div class="price-row">
                                <span class="price">$<%= product.price.toFixed(2) %></span>
                                <span class="old-price">$<%= product.originalPrice.toFixed(2) %></span>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                <% } %>
            </div>
            <!-- PAGINATION -->
            <div class="pagination">
                <% if (currentPage > 1) { %>
                    <a href="/products?page=<%= currentPage-1 %>&search=<%= searchQuery %>" class="page-btn">‹</a>
                <% } %>

                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="/products?page=<%= i %>&search=<%= searchQuery %>"
                        class="page-btn <%= i === currentPage ? 'active' : '' %>">
                        <%= i %>
                    </a>
                <% } %>

                <% if (currentPage < totalPages) { %>
                    <a href="/products?page=<%= currentPage+1 %>&search=<%= searchQuery %>" class="page-btn">›</a>
                <% } %>
                
            </div>

        </main>
    </div>

    <footer class="footer">
        <div class="footer-bottom">
            <p>© 2026 Brand. All rights reserved.</p>
        </div>
    </footer>

    <script src="/script.js"></script>
</body>
</html>